# --- Core ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info

# --- Demo / mock mode -------------------------------------------------------
# Set MOCK_MODE=true to route every platform adapter through MockAdapter.
# This lets you exercise the full pipeline (S3, ffprobe, smart-pad, BullMQ,
# DLQ, dashboard updates) without configuring Google / Meta / X credentials.
#
# MOCK_FAILURE_RATE simulates transient 5xx upstreams so you can see the DLQ
# and exponential backoff actually run. Range 0..1; 0.2 = 20% of publishes
# will retry once before succeeding.
MOCK_MODE=false
MOCK_FAILURE_RATE=0
MOCK_LATENCY_MS=800

# --- Postgres (matches docker-compose.yml) ---
# Host port is 5433 (not the default 5432) so it never clashes with a Postgres
# you may already run locally.
DATABASE_URL=postgresql://omnipost:omnipost@localhost:5433/omnipost?schema=public

# --- Redis ---
# Host port 6380 (not the default 6379) for the same collision-avoidance reason.
REDIS_URL=redis://localhost:6380

# --- Auth ---
# openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# --- AES-256-GCM master key for at-rest token encryption ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OMNIPOST_DATA_KEY=replace-me-base64-32-bytes

# --- S3 / MinIO ---
# Host port 9100 (API) / 9101 (console). Container-internal stays 9000/9001.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=omnipost-media
S3_ACCESS_KEY_ID=omnipost
S3_SECRET_ACCESS_KEY=omnipost-secret
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES_SECONDS=3600

# --- OAuth: YouTube / Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/v1/oauth/youtube/callback

# --- OAuth: Meta (Instagram + Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/v1/oauth/meta/callback

# --- OAuth: X (Twitter v2) ---
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/v1/oauth/x/callback

# --- Web dashboard ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
