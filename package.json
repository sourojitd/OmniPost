{
  "name": "omnipost",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "quickstart": "node scripts/setup.mjs && turbo run dev",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @omnipost/db prisma:generate",
    "db:migrate": "pnpm --filter @omnipost/db prisma:migrate",
    "db:push": "pnpm --filter @omnipost/db prisma:push",
    "seed:demo": "pnpm --filter @omnipost/api seed:demo",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "infra:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "eslint": "^9.13.0",
    "typescript-eslint": "^8.10.0",
    "globals": "^15.11.0"
  },
  "engines": {
    "node": ">=20"
  },
  "author": "Sourojit Dhua",
  "license": "MIT",
  "contributors": [
    "Sourojit Dhua"
  ],
  "attribution": {
    "author": "Sourojit Dhua",
    "copyright": "Copyright (c) 2025 Sourojit Dhua",
    "license": "MIT",
    "notice": "Original author & rights holder. Retain attribution per LICENSE.",
    "sig": "U291cm9qaXQgRGh1YQ=="
  }
}
